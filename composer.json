{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-language-switch": "^4.0",
        "cmsmaxinc/filament-error-pages": "^2.0",
        "endroid/qr-code": "^5.0",
        "filament/filament": "^4.0",
        "guava/calendar": "^2.1",
        "guzzlehttp/guzzle": "^7.2",
        "khaled.alshamaa/ar-php": "^7.0",
        "lara-zeus/activity-timeline": "^5.0",
        "laravel/fortify": "^1.21",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0|^5.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5|^5.0",
        "league/flysystem-aws-s3-v3": "^3.34",
        "shuvroroy/filament-spatie-laravel-backup": "^3.4",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "doctrine/dbal": "^3.10",
        "fakerphp/faker": "^1.23",
        "filament/upgrade": "^4.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-q46n-4fdk-zjr4",
                "PKSA-qzrn-rnz3-85w1",
                "PKSA-w7xr-vk7n-rstm",
                "PKSA-p3rx-dfwp-73ny",
                "PKSA-ckwp-rt7t-c46m",
                "PKSA-4npr-btr6-zhny",
                "PKSA-njrm-6dtg-m2pc",
                "PKSA-985r-hryy-555b",
                "PKSA-jyd3-2srm-pfqd",
                "PKSA-1ds2-yqqr-64g1",
                "PKSA-g5js-3ypd-k2kr"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
