APP_NAME="Gestion Scolarité"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
GESTION_TIME_FORMAT=H:i

# School Configuration
SCHOOL_CODE=ETB
SCHOOL_NAME="École Technique de Base"
SCHOOL_ADDRESS="Nouakchott, Mauritanie"
SCHOOL_PHONE="+222 XX XX XX XX"
SCHOOL_EMAIL="contact@ecole.mr"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestionscolarité
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Custom endpoint for S3-compatible storage (Cloudflare R2 / Backblaze B2 / DO Spaces).
# Leave empty for AWS S3. For R2/B2/Spaces set the endpoint and path-style = true.
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup)
# Disks to store backups on (comma-separated). Add 's3' for off-site, e.g. local,s3
BACKUP_DISKS=local
# Folder/prefix backups are stored under. Defaults to a slug of APP_NAME.
# In multi-tenant, set this per tenant (e.g. the school code).
BACKUP_PREFIX=
# Set a password to encrypt backup archives (AES-256). Strongly recommended off-site.
BACKUP_ARCHIVE_PASSWORD=
# Email notifications: off by default (need working SMTP). Set true once mail works.
BACKUP_NOTIFICATIONS_ENABLED=false
BACKUP_NOTIFICATION_EMAIL=
# Run scheduled backups automatically (requires OS cron running schedule:run).
AUTO_BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# School Configuration
SCHOOL_NAME="École Supérieure"
SCHOOL_ADDRESS=""
SCHOOL_PHONE=""
SCHOOL_EMAIL=""

# Academic Year Configuration
# Month when the academic year starts (1-12): 10=October, 9=September, 8=August
ACADEMIC_YEAR_START_MONTH=10

# Trimester System (Default configuration for Mauritanian schools - October start)
TRIMESTRE_1_START_MONTH=10
TRIMESTRE_1_START_DAY=1
TRIMESTRE_1_END_MONTH=12
TRIMESTRE_1_END_DAY=31

TRIMESTRE_2_START_MONTH=1
TRIMESTRE_2_START_DAY=1
TRIMESTRE_2_END_MONTH=4
TRIMESTRE_2_END_DAY=30

TRIMESTRE_3_START_MONTH=5
TRIMESTRE_3_START_DAY=1
TRIMESTRE_3_END_MONTH=9
TRIMESTRE_3_END_DAY=30

# Alternative: Semester System (set USE_SEMESTERS=true to enable)
USE_SEMESTERS=false
SEMESTER_1_START_MONTH=10
SEMESTER_1_START_DAY=1
SEMESTER_1_END_MONTH=2
SEMESTER_1_END_DAY=28

SEMESTER_2_START_MONTH=3
SEMESTER_2_START_DAY=1
SEMESTER_2_END_MONTH=7
SEMESTER_2_END_DAY=31


SCHOOL_CODE=YSC

# Demo credentials for panel logins (used by Filament login form demo)
# Set DEMO_PANEL to force which role's demo credentials are shown: admin, staff, teacher
DEMO_PANEL=
DEMO_ADMIN_EMAIL=admin@ecole.com
DEMO_ADMIN_PASSWORD=password123
DEMO_STAFF_EMAIL=secretaire@ecole.com
DEMO_STAFF_PASSWORD=password123
DEMO_TEACHER_EMAIL=aminetou@ecole.com
DEMO_TEACHER_PASSWORD=teacher123
